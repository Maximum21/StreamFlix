root = true

[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 120
ktlint_function_naming_ignore_when_annotated_with = Composable
ij_kotlin_packages_to_use_import_on_demand = androidx.compose.animation.*,androidx.compose.foundation.layout.*,androidx.compose.material.icons.filled.*,androidx.compose.material3.*,androidx.compose.runtime.*,kotlinx.coroutines.flow.*
